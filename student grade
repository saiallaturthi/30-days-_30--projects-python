def calculate_grade(percentage):
    """Return the grade based on percentage."""
    if percentage >= 90:
        return "A+"
    elif percentage >= 80:
        return "A"
    elif percentage >= 70:
        return "B"
    elif percentage >= 60:
        return "C"
    elif percentage >= 50:
        return "D"
    else:
        return "Fail"

def student_grade_system():
    """Main function to collect student info, calculate grade, and display report."""
    
    # Create a dictionary to store student data
    student = {}

    # 1. Get student details
    name = input("Enter student name: ")
    subject1 = float(input("Enter marks for Subject 1: "))
    subject2 = float(input("Enter marks for Subject 2: "))
    subject3 = float(input("Enter marks for Subject 3: "))

    # 2. Calculate total and percentage
    total = subject1 + subject2 + subject3
    percentage = total / 3

    # 3. Get grade
    grade = calculate_grade(percentage)

    # 4. Store all details in dictionary
    student["Name"] = name
    student["Subject 1"] = subject1
    student["Subject 2"] = subject2
    student["Subject 3"] = subject3
    student["Total Marks"] = total
    student["Percentage"] = round(percentage, 2)
    student["Grade"] = grade

    # 5. Print Report in proper order
    print("\n===== Student Report =====")
    print(f"Name         : {student['Name']}")
    print(f"Subject 1    : {student['Subject 1']}")
    print(f"Subject 2    : {student['Subject 2']}")
    print(f"Subject 3    : {student['Subject 3']}")
    print(f"Total Marks  : {student['Total Marks']}")
    print(f"Percentage   : {student['Percentage']}%")
    print(f"Grade        : {student['Grade']}")
    print("==========================")

# Run the program
student_grade_system()
 
